# Copiar este archivo como .env:  cp .env.example .env

# ---- Modo simulado (1 = simulado, 0 = real) ------------------------------------
# Con ambos en 1 la demo funciona sin PostgreSQL y sin API key.
# FAKE_DB=1  -> usa una base SQLite local (demo_fake.db, se crea sola)
# FAKE_LLM=1 -> usa un LLM simulado por reglas que imita la API de OpenAI
FAKE_DB=0
FAKE_LLM=0

# ---- IA real (solo si FAKE_LLM=0) ----------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-COMPLETAR
# Modelo con soporte de tool calling
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- PostgreSQL real (solo si FAKE_DB=0) ---------------------------------------
# Crear las tablas con: psql -h <host> -U <usuario> -d <base> -f schema.sql
PGHOST=localhost
PGPORT=5432
PGDATABASE=hotel
PGUSER=postgres
PGPASSWORD=COMPLETAR
# disable | prefer | require
PGSSLMODE=prefer
